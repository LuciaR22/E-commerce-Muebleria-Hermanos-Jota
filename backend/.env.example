# Conexion a la base de datos MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<base-de-datos>

# Clave secreta para firmar tokens JWT (cadena larga y aleatoria)
JWT_SECRET=tu_clave_secreta_aqui

# Tiempo de expiracion del token JWT (ej. 1h, 24h, 7d)
JWT_EXPIRES_IN=1h

# Puerto del servidor backend (por defecto 5000)
PORT=5000

# URL del cliente frontend permitida en CORS (ej. https://e-commerce-muebleria-hermanos-jota.vercel.app)
CLIENT_URL=http://localhost:5173
